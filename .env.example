# Copy to .env.local and fill in. Never commit real secrets.

# Public base URL (no trailing slash). Used for Stripe return URLs and links
# inside transactional emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Postgres) ------------------------------------------------
# Dockerized locally (see docker-compose.yml); Vercel Postgres in prod.
DATABASE_URL=postgres://app:app@localhost:5434/baseball

# --- Auth (operator portal) ---------------------------------------------
# Session/JWT secret for Auth.js. Generate one: `openssl rand -base64 32`.
AUTH_SECRET=
# First admin, created by `npm run db:seed`. Dev defaults apply if unset.
SEED_ADMIN_EMAIL=yuta@example.com
SEED_ADMIN_PASSWORD=changeme123

# --- Object storage -----------------------------------------------------
# Dev: local disk under this dir. Prod: leave unset and set BLOB_READ_WRITE_TOKEN.
STORAGE_DIR=./.storage
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx      # prod only (Vercel Blob)

# --- Stripe -------------------------------------------------------------
# Publishable key (pk_...) from https://dashboard.stripe.com/apikeys.
# Sent to the browser on purpose — it can only create payment attempts, never
# read or move money. Must be from the SAME mode (test/live) as the secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret for the checkout webhook (Developers → Webhooks, or the
# secret printed by `stripe listen` during local development).
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional. A pre-created Price ID (price_...). Leave unset to price the
# checkout inline from the amount in src/lib/site.ts.
# STRIPE_PRICE_ID=price_xxx

# --- Mux ----------------------------------------------------------------
# Access token from https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=xxx
MUX_TOKEN_SECRET=xxx
# Signing secret for the Mux webhook (Settings → Webhooks).
MUX_WEBHOOK_SECRET=xxx

# --- Airtable -----------------------------------------------------------
# Personal access token with data.records:read/write on the base.
AIRTABLE_API_KEY=pat_xxx
# Base ID (app...) from https://airtable.com/api
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
# Table name (defaults to "Submissions" if unset).
AIRTABLE_TABLE_NAME=Submissions
# Shared secret for the /api/webhooks/airtable notify endpoint. Set the same
# value on the Airtable "Send request" automation's x-webhook-secret header.
# Generate one with e.g. `openssl rand -hex 32`.
AIRTABLE_WEBHOOK_SECRET=

# --- Email (Resend) -----------------------------------------------------
# Optional. If unset, emails are skipped (logged, never fatal).
# RESEND_API_KEY=re_xxx
# Verified sender. Falls back to Resend's onboarding sender if unset.
# EMAIL_FROM=Diamond Path <hello@yourdomain.com>
