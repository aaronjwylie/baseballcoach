# Copy to .env.local and fill in. Never commit real secrets.

# Public base URL (no trailing slash). Used for Stripe return URLs, Mux CORS,
# and links inside transactional emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe -------------------------------------------------------------
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret for the checkout webhook (Developers → Webhooks, or the
# secret printed by `stripe listen` during local development).
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional. A pre-created Price ID (price_...). Leave unset to price the
# checkout inline from the amount in src/lib/site.ts.
# STRIPE_PRICE_ID=price_xxx

# --- Mux ----------------------------------------------------------------
# Access token from https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=xxx
MUX_TOKEN_SECRET=xxx
# Signing secret for the Mux webhook (Settings → Webhooks).
MUX_WEBHOOK_SECRET=xxx

# --- Airtable -----------------------------------------------------------
# Personal access token with data.records:read/write on the base.
AIRTABLE_API_KEY=pat_xxx
# Base ID (app...) from https://airtable.com/api
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
# Table name (defaults to "Submissions" if unset).
AIRTABLE_TABLE_NAME=Submissions
# Shared secret for the /api/webhooks/airtable notify endpoint. Set the same
# value on the Airtable "Send request" automation's x-webhook-secret header.
# Generate one with e.g. `openssl rand -hex 32`.
AIRTABLE_WEBHOOK_SECRET=

# --- Email (Resend) -----------------------------------------------------
# Optional. If unset, emails are skipped (logged, never fatal).
# RESEND_API_KEY=re_xxx
# Verified sender. Falls back to Resend's onboarding sender if unset.
# EMAIL_FROM=Diamond Path <hello@yourdomain.com>
